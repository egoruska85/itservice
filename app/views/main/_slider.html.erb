<div class="owl-container">
  <div class="owl-carousel-wrapper">
    <button class="owl-nav-btn owl-prev-btn" id="owlPrev">❮</button>

    <div class="owl-viewport">
      <div class="owl-track" id="owlTrack">

        <% @services.each do |service| %>
        <div class="owl-item">
          <!-- 1. Обертка для 3D перспективы -->
          <div class="owl-card-perspective">
            <!-- 2. Элемент, который будет наклоняться -->
            <div class="owl-card-parallax">

              <div class="owl-card">
                <% if service.pictogramm.attached? %>
                  <div class="owl-icon">
                    <%= service.pictogramm.download.html_safe %>
                  </div>
                <% end %>
                <h3 class="owl-title"><%= service.name %></h3>
                <p class="owl-text"><%= simple_format truncate(service.explanation, length: 100) %></p>

                <%= link_to 'Подробнее', service_path(service), class:"owl-link" %>
              </div>

            </div>
          </div>
        </div>
        <% end %>

      </div>
    </div>

    <button class="owl-nav-btn owl-next-btn" id="owlNext">❯</button>
  </div>
  <div class="owl-dots" id="owlDots"></div>
</div>
